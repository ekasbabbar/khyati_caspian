# Local product loop
KHYATI_EVENTS_PATH=data/sample_events.json
KHYATI_USE_LLM=true

# LLM provider: gemini (free tier), deepseek, or openai
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite

# Add the key for the provider selected above.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Optional generic overrides
# LLM_API_KEY=
# LLM_BASE_URL=

# Caspian
CASPIAN_API_KEY=
CASPIAN_BASE_URL=https://api.trycaspianai.com
CASPIAN_EMAIL_USERNAME=khyati

# "twilio-whatsapp" is fastest for a hackathon demo.
# Meta Embedded Signup uses a separate one-time onboarding flow.
CASPIAN_WHATSAPP_PROVIDER=twilio-whatsapp
