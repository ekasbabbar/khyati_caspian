# Local career-agent loop
KHYATI_EVENTS_PATH=data/sample_events.json
KHYATI_KNOWLEDGE_DIR=knowledge
KHYATI_KNOWLEDGE_INDEX=.khyati/knowledge.sqlite3
KHYATI_USE_LLM=true

# LLM provider: gemini (free tier), deepseek, or openai
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=60
LLM_MAX_CONCURRENT=2

# Add the key for the provider selected above.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Optional generic overrides
# LLM_API_KEY=
# LLM_BASE_URL=

# Caspian
CASPIAN_API_KEY=
CASPIAN_BASE_URL=https://api.trycaspianai.com
CASPIAN_EMAIL_USERNAME=khyati

# Create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=
# Only this Telegram username may use the private owner channel.
KHYATI_OWNER_TELEGRAM_USERNAME=@your_username
