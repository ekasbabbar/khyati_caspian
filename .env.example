# Local career-agent loop
KHYATI_EVENTS_PATH=data/sample_events.json
KHYATI_KNOWLEDGE_DIR=knowledge
KHYATI_KNOWLEDGE_INDEX=.khyati/knowledge.sqlite3
KHYATI_OWNER_CHANNEL_STATE=.khyati/owner_channel.json
KHYATI_APPROVAL_STATE=.khyati/pending_approvals.json
KHYATI_OUTBOUND_STATE=.khyati/outbound_drafts.json
KHYATI_EMAIL_THREAD_STATE=.khyati/email_threads.json
KHYATI_USE_LLM=true

# Production state. Leave blank for local JSON/SQLite development mode.
DATABASE_URL=

# Optional private object-storage manifest. When set, it replaces KHYATI_KNOWLEDGE_DIR.
KHYATI_KNOWLEDGE_MANIFEST_URL=
KHYATI_KNOWLEDGE_MANIFEST_TOKEN=
KHYATI_KNOWLEDGE_CACHE_DIR=.khyati/knowledge_sources

# Ordered provider chain: Featherless primary, Gemini secondary
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen3-32B
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_TIMEOUT_SECONDS=15

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_TIMEOUT_SECONDS=12

LLM_MAX_CONCURRENT=2
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=60

# Add the key for the provider selected above.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Optional generic overrides
# LLM_API_KEY=
# LLM_BASE_URL=

# Caspian
CASPIAN_API_KEY=
CASPIAN_BASE_URL=https://api.trycaspianai.com
CASPIAN_EMAIL_USERNAME=khyati

# Optional recruiter-facing Telegram gateway.
TELEGRAM_BOT_TOKEN=
KHYATI_OWNER_TELEGRAM_USERNAME=@your_username

# URL's for production
