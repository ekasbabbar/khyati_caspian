# Copy to /etc/khyati/khyati.env, fill it there, and chmod it 600.
CASPIAN_API_KEY=
CASPIAN_BASE_URL=https://api.trycaspianai.com
CASPIAN_EMAIL_USERNAME=khyati
TELEGRAM_BOT_TOKEN=
KHYATI_OWNER_TELEGRAM_USERNAME=@your_username

FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen3-32B
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_TIMEOUT_SECONDS=15
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_TIMEOUT_SECONDS=12

DATABASE_URL=
# Preferred production knowledge source; credentials come from the EC2 IAM role.
AWS_REGION=ap-south-1
KHYATI_KNOWLEDGE_S3_BUCKET=
KHYATI_KNOWLEDGE_S3_MANIFEST_KEY=current/manifest.json

# HTTPS manifest fallback (leave blank when using S3).
KHYATI_KNOWLEDGE_MANIFEST_URL=
KHYATI_KNOWLEDGE_MANIFEST_TOKEN=
KHYATI_KNOWLEDGE_CACHE_DIR=/opt/khyati/app/.khyati/knowledge_sources
KHYATI_KNOWLEDGE_INDEX=/opt/khyati/app/.khyati/knowledge.sqlite3

LLM_MAX_CONCURRENT=2
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=60
