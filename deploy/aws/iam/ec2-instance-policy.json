{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadKhyatiKnowledge",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::REPLACE_KHYATI_BUCKET/*"
    },
    {
      "Sid": "ListKhyatiKnowledge",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_KHYATI_BUCKET"
    }
  ]
}
